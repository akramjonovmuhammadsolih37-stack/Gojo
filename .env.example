# ═══════════════════════════════════════════
# GOJO-USERBOT — Muhit o'zgaruvchilari
# Bu faylni .env deb saqlang va to'ldiring
# ═══════════════════════════════════════════

# Telegram API — https://my.telegram.org dan oling
# 1. my.telegram.org ga kiring
# 2. "API development tools" bo'limini oching
# 3. App yarating — API_ID va API_HASH beriladi
API_ID=
API_HASH=

# Telegram session — get_session.py orqali oling:
#   python get_session.py
SESSION_STRING=

# Bot token — .help komandasi uchun (ixtiyoriy)
# BotFather dan oling: https://t.me/BotFather
BOT_TOKEN=

# Admin uchun parol (bo'sh qolsa avtomatik yaratiladi va terminalga chiqadi)
ADMIN_PASSWORD=

# Server porti (odatda 5000, hosting uchun PORT o'zgaruvchisi ishlatiladi)
PORT=5000
